# Academy Desk — environment template
# Copy this file to .env and fill in your own values:
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env

# 1. MongoDB Atlas connection string.
#    Atlas dashboard → your cluster → Connect → Drivers → copy the URI.
#    Replace <password> with the database-user password (not your Atlas login).
#    Keep retryWrites=true and the database name (academydesk) at the end.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/academydesk?retryWrites=true&w=majority"

# 2. Session secret — any long random string (used to sign the login cookie).
#    Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"
